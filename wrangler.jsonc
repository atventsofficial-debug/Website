// Cloudflare Workers deploy (`npx wrangler deploy`). The build (scripts/build-site.mjs) writes
// site/ and worker/catalog.json. Cloudflare serves the files in site/ as they are, with the
// security headers from site/_headers. The Worker (worker/index.mjs) answers only addresses
// with no file behind them: the Midtrans payments for 3D passes. Its secret,
// MIDTRANS_SERVER_KEY, is set in the Cloudflare dashboard as a Secret, never in this file.
// The Node server in server/ is not part of the deploy.
{
  "name": "website",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node scripts/build-site.mjs" },
  "assets": { "directory": "./site", "binding": "ASSETS" },
  // Per visitor address: orders started, and payment checks, per minute.
  "ratelimits": [
    { "name": "PAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "STATUS_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Variables set in the dashboard survive a deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
