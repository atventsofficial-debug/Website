// Cloudflare Workers deploy (`npx wrangler deploy`). The build (scripts/build-site.mjs) writes
// site/ and worker/catalog.json. Cloudflare serves the files in site/ as they are, with the
// security headers from site/_headers. The Worker (worker/index.mjs) answers only addresses
// with no file behind them: the Midtrans payments for 3D passes and the pass email. Its
// secrets, MIDTRANS_SERVER_KEY, MIDTRANS_SIGNATURE_KEY and RESEND_API_KEY, are set in the Cloudflare dashboard as
// Secrets, never in this file (README, Payments). The Node server in server/ is not part of
// the deploy.
{
  "name": "website",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node scripts/build-site.mjs" },
  "assets": { "directory": "./site", "binding": "ASSETS" },
  // Per minute. Orders started: per visitor address (raised from 10: phones on one mobile
  // network often share an address). Payment checks and seat-mate changes: per pass and
  // address. Seat-mate lists: per pass and address, well above one every 8 seconds.
  "ratelimits": [
    { "name": "PAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "STATUS_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "FANS_LIMIT", "namespace_id": "1003", "simple": { "limit": 40, "period": 60 } }
  ],
  // The order book (worker/orders.mjs). With no database_id, Cloudflare makes the database
  // on the first deploy and keeps using it; its table is made on first use.
  "d1_databases": [{ "binding": "DB", "database_name": "atvents-orders" }],
  // Preview builds (`wrangler preview`, run by Workers Builds for pull requests) need their
  // own rate-limit namespaces and their own order book, so a preview never shares
  // production's counters or writes to its orders.
  "previews": {
    "d1_databases": [{ "binding": "DB", "database_name": "atvents-orders-preview", "database_id": "b5d7c503-f92e-47a0-a2d9-08bbd9815b30" }],
    "ratelimits": [
      { "name": "PAY_LIMIT", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } },
      { "name": "STATUS_LIMIT", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
      { "name": "FANS_LIMIT", "namespace_id": "3003", "simple": { "limit": 40, "period": 60 } }
    ]
  },
  // Variables set in the dashboard survive a deploy: the secrets above, and the public
  // MIDTRANS_CLIENT_KEY, GOOGLE_CLIENT_ID and MICROSOFT_CLIENT_ID (README, Payments), and
  // FANBASE_WA, the WhatsApp fan group's invite link that paid passes see (README, Seat mates).
  "keep_vars": true,
  "observability": { "enabled": true },
  // The staging copy (README, Staging): `npx wrangler deploy --env staging` makes a second
  // Worker, website-staging, with its own order book and its own variables, so it never
  // touches the live site's orders or keys. Give it Midtrans Sandbox keys only. Its Worker
  // runs before every file, to tell search engines to leave it out (STAGING).
  "env": {
    "staging": {
      "name": "website-staging",
      "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true },
      "vars": { "STAGING": "1" },
      "ratelimits": [
        { "name": "PAY_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "STATUS_LIMIT", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "FANS_LIMIT", "namespace_id": "2003", "simple": { "limit": 40, "period": 60 } }
      ],
      "d1_databases": [{ "binding": "DB", "database_name": "atvents-orders-staging" }],
      "observability": { "enabled": true }
    }
  }
}
