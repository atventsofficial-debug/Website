# Copy to .env. Secrets belong here or in your host's secret store, never in the code.

PORT=8080
# Postgres keeps the clicks to tiket.com, the 3D passes, the affiliate report, partner
# requests and sign-ups. Required.
DATABASE_URL=postgres://seatsight:seatsight@localhost:5432/seatsight
# Public address of the site. Must be https in production.
PUBLIC_URL=http://localhost:8080
# Set to production on a live server: turns on the strict start-up checks.
NODE_ENV=development

# Protects the admin page and its API (Authorization: Bearer <token>).
# Required in production, at least 24 characters. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# tiket.com deeplink from your affiliate network, once the programme approves the site.
# {url} becomes the concert's tiket.com page, {sub} our click id (the network reports sales
# by it), {src} the campaign and {event} the concert id. https only; {url} and {sub} required.
# Empty: buy buttons use affiliateLink in js/config.js, or go straight to tiket.com.
# Involve Asia, for example:
# AFFILIATE_LINK=https://invol.co/aff_m?offer_id=OFFER&aff_id=AFFILIATE&source=deeplink_generator&url={url}&aff_sub={sub}&aff_sub2={src}&aff_sub3={event}
AFFILIATE_LINK=

# Set true only behind a reverse proxy you control, so rate limits see the real client IP.
TRUST_PROXY=false
